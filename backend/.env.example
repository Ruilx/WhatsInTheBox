# 后端环境变量示例（复制为 .env 后填写；.env 切勿提交到仓库）
# 注意：DB_HOST 在 Docker 内网中填 MySQL 服务名（如 db），本地开发填实际 IP。

# ---- 数据库连接 ----
DB_HOST=db
DB_PORT=3306
DB_USER=whatsinthebox_rw
DB_PASSWORD=<换成 rw 密码>
DB_NAME=whatsinthebox
DB_CHARSET=utf8mb4
# 是否启用 SSL 连接（caching_sha2 建议 true；同内网可酌情 false）
DB_SSL=true

# ---- 应用 ----
# 全局页前缀（活动 URL 首段保留字），默认 _wb
GLOBAL_PREFIX=_wb
# API 路由统一前缀
API_PREFIX=/whatsinthebox
# 登录会话有效期（小时）
SESSION_EXPIRE_HOURS=4
# Cookie 名
COOKIE_NAME=witb_token
# 允许的前端源（逗号分隔，生产填前端域名；本地 http://localhost）
CORS_ORIGINS=http://localhost

# ---- 管理员初始化（seed.py 使用）----
ADMIN_USER=admin
ADMIN_PASS=<换成 admin 密码>

# ---- 上传目录（容器内绝对路径）----
UPLOAD_DIR=/app/uploads
